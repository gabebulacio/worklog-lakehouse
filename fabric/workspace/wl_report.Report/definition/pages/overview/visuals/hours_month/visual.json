{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "hours_month",
  "position": {
    "x": 650,
    "y": 150,
    "z": 5,
    "height": 270,
    "width": 610,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Date.Month",
              "nativeQueryRef": "Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Worklog"
                    }
                  },
                  "Property": "Hours Logged"
                }
              },
              "queryRef": "Worklog.Hours Logged",
              "nativeQueryRef": "Hours Logged"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Hours logged by month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
