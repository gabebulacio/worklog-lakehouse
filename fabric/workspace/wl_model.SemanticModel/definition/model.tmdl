model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table Date
ref table User
ref table Account
ref table Project
ref table Deliverable
ref table Worklog
ref table Capacity
ref table Assignment
ref table 'Non-loggers'
ref table 'Unmatched Workers'
