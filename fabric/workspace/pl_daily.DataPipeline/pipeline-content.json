{
  "properties": {
    "description": "Daily incremental run. Notebook and workspace IDs are sentinels that fabric/parameter.yml swaps at deploy time.",
    "activities": [
      {
        "name": "Run orchestrator (incremental)",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 300,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "11111111-1111-1111-1111-111111111111",
          "workspaceId": "22222222-2222-2222-2222-222222222222",
          "parameters": {
            "mode": {
              "value": "incremental",
              "type": "string"
            },
            "updated_since_hours": {
              "value": "48",
              "type": "int"
            },
            "land_synthetic": {
              "value": "true",
              "type": "bool"
            }
          }
        }
      }
    ]
  }
}
